{
    "name": "embegeq/embegeq",
    "type": "project",
    "description": "The EmbegeQ Application Skeleton.",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "embegeq/framework": "dev-main",
        "vlucas/phpdotenv": "^5.6",
        "nyholm/psr7-server": "^1.1",
        "nikic/fast-route": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
